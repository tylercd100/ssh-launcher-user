#!/usr/bin/env bash
# ssh-launcher-user
#
# Create a dedicated Linux user that auto-launches a chosen command on
# interactive SSH login. Useful for sandboxing AI coding agents
# (claude, codex, aider, gemini, opencode, goose, cursor-agent, ...) on
# a host while keeping their state, sudo scope, and code tree isolated
# from your primary user.
#
# Subcommands:
#   create     create the user (default if no subcommand given)
#   rollback   undo a previous setup (remove user, restore moved dir,
#              uninstall installed binary)
#
# Interactive by default; accepts flags for non-interactive use.
#
# Run as a regular sudoer user — the script will `sudo` internally where
# needed. Refuses to run as root so $SUDO_USER context stays clean.
#
# See README.md for design rationale (recursive-exec trap, why we
# guard with AUTO_LAUNCHED, etc.).

set -euo pipefail

VERSION="0.2.0"
SCRIPT_NAME="ssh-launcher-user"

# ---------- presets ----------
declare -A PRESETS=(
    [claude]="claude"
    [codex]="codex"
    [aider]="aider"
    [gemini]="gemini"
    [opencode]="opencode"
    [goose]="goose session"
    [cursor-agent]="cursor-agent"
    [shell]=""
)

# Opt-in "skip all prompts" flags per preset. Interactive flow asks before
# appending; non-interactive runs leave these off (use --launch-cmd to opt in).
declare -A DANGER_FLAGS=(
    [claude]="--dangerously-skip-permissions"
    [aider]="--yes-always"
)
declare -A DANGER_DESCRIPTIONS=(
    [claude]="auto-approves every tool use (file edits, shell commands, network calls) with no prompts"
    [aider]="auto-accepts every confirmation prompt (file edits, commits, model switches) without asking"
)

DEFAULT_PRESET=claude

# ---------- helpers ----------
say()    { printf '%s\n' "$*"; }
info()   { printf '\e[36m[*]\e[0m %s\n' "$*"; }
ok()     { printf '\e[32m[+]\e[0m %s\n' "$*"; }
warn()   { printf '\e[33m[!]\e[0m %s\n' "$*" >&2; }
err()    { printf '\e[31m[x]\e[0m %s\n' "$*" >&2; }
die()    { err "$*"; exit 1; }

# Read from /dev/tty so prompts still work under `curl | bash`
_read() {
    if [[ -t 0 ]]; then
        read -r "$@"
    else
        read -r "$@" < /dev/tty
    fi
}

prompt() {
    local question="$1" default="${2:-}" answer
    if [[ -n "$default" ]]; then
        _read -p "$question [$default]: " answer
        printf '%s' "${answer:-$default}"
    else
        _read -p "$question: " answer
        printf '%s' "$answer"
    fi
}

prompt_yn() {
    local question="$1" default="${2:-y}" answer prompt_suffix
    if [[ "$default" == "y" ]]; then prompt_suffix="[Y/n]"; else prompt_suffix="[y/N]"; fi
    while true; do
        _read -p "$question $prompt_suffix: " answer
        answer="${answer:-$default}"
        case "$answer" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo])     return 1 ;;
            *) warn "Please answer yes or no." ;;
        esac
    done
}

preflight() {
    [[ $EUID -eq 0 ]] && die "Run as a regular sudoer — refusing to run as root."
    command -v sudo >/dev/null || die "sudo is required."
}

# =====================================================
#   create
# =====================================================
usage_create() {
    cat <<EOF
$SCRIPT_NAME create — create a dedicated SSH user that auto-launches a command on login.

USAGE
    $SCRIPT_NAME create [OPTIONS]
    $SCRIPT_NAME       [OPTIONS]      # 'create' is the default subcommand

OPTIONS
    --username NAME              New user's name (required for non-interactive)
    --preset NAME                One of: ${!PRESETS[@]} (default: $DEFAULT_PRESET)
    --launch-cmd 'CMD'           Custom launch command (overrides --preset)
    --source-dir PATH            Existing dir to move into new user's home
    --dest-name NAME             Rename moved dir (default: basename of source)
    --source-user USER           User to copy SSH keys / gitconfig from (default: \$SUDO_USER or \$USER)
    --install-binary PATH        Copy this binary to /usr/local/bin/<name> so the new user can run it
    --[no-]sudo                  Add new user to sudo group (default: yes)
    --[no-]copy-ssh-keys         Copy --source-user's authorized_keys (default: yes)
    --[no-]copy-gitconfig        Copy --source-user's .gitconfig (default: yes)
    --[no-]enable-password-auth  Enable PasswordAuthentication in sshd if disabled (default: yes)
    --[no-]set-password          Run passwd interactively after setup (default: yes)
    --yes, -y                    Skip confirmation prompts
    --dry-run                    Print actions instead of executing
    --help, -h                   Show this help

PRESETS
$(for k in "${!PRESETS[@]}"; do printf '    %-14s %s\n' "$k" "${PRESETS[$k]:-(plain shell)}"; done)

EXAMPLES
    # Fully interactive
    $SCRIPT_NAME

    # Non-interactive — set up a 'codebot' user that auto-runs claude in ~/proj
    $SCRIPT_NAME --username codebot --preset claude \\
        --source-dir ~/code/proj --yes

    # Custom command
    $SCRIPT_NAME --username opsbot --launch-cmd 'tmux attach -t ops || tmux new -s ops'
EOF
}

cmd_create() {
    preflight

    USERNAME=""
    PRESET=""
    LAUNCH_CMD=""
    SOURCE_DIR=""
    DEST_NAME=""
    SOURCE_USER="${SUDO_USER:-$USER}"
    ADD_SUDO=1
    COPY_SSH_KEYS=1
    COPY_GITCONFIG=1
    ENABLE_PASSWORD_AUTH=1
    SET_PASSWORD=1
    INSTALL_BINARY=""
    ASSUME_YES=0
    DRY_RUN=0
    LAUNCH_CMD_SET=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --username)              USERNAME="$2"; shift 2 ;;
            --preset)                PRESET="$2"; shift 2 ;;
            --launch-cmd)            LAUNCH_CMD="$2"; LAUNCH_CMD_SET=1; shift 2 ;;
            --source-dir)            SOURCE_DIR="$2"; shift 2 ;;
            --dest-name)             DEST_NAME="$2"; shift 2 ;;
            --source-user)           SOURCE_USER="$2"; shift 2 ;;
            --install-binary)        INSTALL_BINARY="$2"; shift 2 ;;
            --sudo)                  ADD_SUDO=1; shift ;;
            --no-sudo)               ADD_SUDO=0; shift ;;
            --copy-ssh-keys)         COPY_SSH_KEYS=1; shift ;;
            --no-copy-ssh-keys)      COPY_SSH_KEYS=0; shift ;;
            --copy-gitconfig)        COPY_GITCONFIG=1; shift ;;
            --no-copy-gitconfig)     COPY_GITCONFIG=0; shift ;;
            --enable-password-auth)    ENABLE_PASSWORD_AUTH=1; shift ;;
            --no-enable-password-auth) ENABLE_PASSWORD_AUTH=0; shift ;;
            --set-password)          SET_PASSWORD=1; shift ;;
            --no-set-password)       SET_PASSWORD=0; shift ;;
            -y|--yes)                ASSUME_YES=1; shift ;;
            --dry-run)               DRY_RUN=1; shift ;;
            -h|--help)               usage_create; exit 0 ;;
            *) die "Unknown option: $1. Try '$SCRIPT_NAME create --help'." ;;
        esac
    done

    local INTERACTIVE=1
    [[ -n "$USERNAME" && $ASSUME_YES -eq 1 ]] && INTERACTIVE=0

    if [[ $INTERACTIVE -eq 1 ]]; then
        say
        say "==================================================="
        say "  $SCRIPT_NAME v$VERSION — create"
        say "  Set up a dedicated SSH user that auto-launches"
        say "  a chosen command on interactive login."
        say "==================================================="
        say

        [[ -z "$USERNAME" ]] && USERNAME="$(prompt 'New username')"
        [[ -z "$USERNAME" ]] && die "Username is required."

        if [[ -z "$PRESET" && $LAUNCH_CMD_SET -eq 0 ]]; then
            say
            say "Auto-launch preset:"
            local i=1 preset_keys=()
            for k in "${!PRESETS[@]}"; do
                printf '  %d) %-14s %s\n' "$i" "$k" "${PRESETS[$k]:-(plain shell — no auto-launch)}"
                preset_keys+=("$k")
                ((i++))
            done
            printf '  %d) %-14s %s\n' "$i" "custom" "(enter your own command)"
            say
            local choice
            choice="$(prompt 'Choose' "$DEFAULT_PRESET")"
            if [[ "$choice" =~ ^[0-9]+$ ]]; then
                if (( choice >= 1 && choice <= ${#preset_keys[@]} )); then
                    PRESET="${preset_keys[$((choice-1))]}"
                elif (( choice == i )); then
                    PRESET="custom"
                else
                    die "Invalid choice: $choice"
                fi
            else
                PRESET="$choice"
            fi
        fi

        if [[ "$PRESET" == "custom" ]]; then
            LAUNCH_CMD="$(prompt 'Custom launch command (leave empty for plain shell)')"
        elif [[ -n "$PRESET" ]]; then
            [[ -v "PRESETS[$PRESET]" ]] || die "Unknown preset: $PRESET"
            LAUNCH_CMD="${PRESETS[$PRESET]}"
        fi

        # Tool-specific opt-in for "skip all prompts" flags
        if [[ -v "DANGER_FLAGS[$PRESET]" ]]; then
            local flag="${DANGER_FLAGS[$PRESET]}"
            local desc="${DANGER_DESCRIPTIONS[$PRESET]}"
            if [[ "$LAUNCH_CMD" != *"$flag"* ]]; then
                say
                warn "$flag $desc."
                warn "On a sudoer SSH user, that effectively grants whoever connects"
                warn "unattended root-capable execution."
                if prompt_yn "Append $flag to the $PRESET launch command?" "n"; then
                    LAUNCH_CMD="$LAUNCH_CMD $flag"
                fi
            fi
        fi

        say
        if prompt_yn "Move an existing directory into ~$USERNAME/?" "n"; then
            [[ -z "$SOURCE_DIR" ]] && SOURCE_DIR="$(prompt 'Source directory path')"
            SOURCE_DIR="${SOURCE_DIR/#\~/$HOME}"
            [[ -d "$SOURCE_DIR" ]] || die "Not a directory: $SOURCE_DIR"
            [[ -z "$DEST_NAME" ]] && DEST_NAME="$(prompt 'Destination dir name under ~'"$USERNAME"'/' "$(basename "$SOURCE_DIR")")"
        fi

    fi

    [[ -n "$USERNAME" ]] || die "Username is required (--username)."
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username: '$USERNAME'"

    if [[ -n "$PRESET" && "$PRESET" != "custom" ]]; then
        [[ -v "PRESETS[$PRESET]" ]] || die "Unknown preset: $PRESET. Options: ${!PRESETS[*]}"
        [[ -z "$LAUNCH_CMD" && $LAUNCH_CMD_SET -eq 0 ]] && LAUNCH_CMD="${PRESETS[$PRESET]}"
    fi

    if [[ -n "$SOURCE_DIR" ]]; then
        SOURCE_DIR="${SOURCE_DIR/#\~/$HOME}"
        [[ -d "$SOURCE_DIR" ]] || die "Not a directory: $SOURCE_DIR"
        [[ -z "$DEST_NAME" ]] && DEST_NAME="$(basename "$SOURCE_DIR")"
    fi

    if [[ -n "$INSTALL_BINARY" ]]; then
        INSTALL_BINARY="${INSTALL_BINARY/#\~/$HOME}"
        [[ -x "$INSTALL_BINARY" ]] || die "Not executable: $INSTALL_BINARY"
    fi

    id "$SOURCE_USER" >/dev/null 2>&1 || die "Source user does not exist: $SOURCE_USER"

    # Verify the launch command's binary is accessible to the NEW user — not just
    # the current one. `command -v claude` finds claude in ~tyler/.local/bin/,
    # but ~tyler is 0700 so the new user can't read it. Detect that and offer
    # to install the binary system-wide.
    if [[ -n "$LAUNCH_CMD" && -z "$INSTALL_BINARY" ]]; then
        local binary="${LAUNCH_CMD%% *}"
        local binary_path=""
        if [[ "${binary:0:1}" == "/" ]]; then
            binary_path="$binary"
        else
            binary_path="$(command -v "$binary" 2>/dev/null || true)"
        fi

        local resolved="" src_home="" issue=""
        if [[ -z "$binary_path" ]]; then
            issue="not found in PATH"
        else
            resolved="$(readlink -f "$binary_path" 2>/dev/null || echo "$binary_path")"
            src_home="$(getent passwd "$SOURCE_USER" | cut -d: -f6)"
            if [[ -n "$src_home" && "$resolved" == "$src_home"/* ]]; then
                issue="resolves to $resolved (inside $SOURCE_USER's home — new user can't read it)"
            fi
        fi

        if [[ -n "$issue" ]]; then
            say
            warn "'$binary' $issue."
            if (( INTERACTIVE )); then
                if prompt_yn "Install the binary system-wide to /usr/local/bin/$binary?" "y"; then
                    INSTALL_BINARY="$(prompt 'Path to the binary to install' "$resolved")"
                    INSTALL_BINARY="${INSTALL_BINARY/#\~/$HOME}"
                    [[ -x "$INSTALL_BINARY" ]] || die "Not executable: $INSTALL_BINARY"
                fi
            else
                warn "Pass --install-binary ${resolved:-PATH} to install it system-wide."
            fi
        fi
    fi

    say
    say "===================="
    say "  Plan"
    say "===================="
    printf '  %-22s %s\n' "Username:"          "$USERNAME"
    printf '  %-22s %s\n' "Source user:"       "$SOURCE_USER"
    printf '  %-22s %s\n' "Add to sudo:"       "$(((ADD_SUDO))         && echo yes || echo no)"
    printf '  %-22s %s\n' "Copy SSH keys:"     "$(((COPY_SSH_KEYS))    && echo yes || echo no)"
    printf '  %-22s %s\n' "Copy .gitconfig:"   "$(((COPY_GITCONFIG))   && echo yes || echo no)"
    printf '  %-22s %s\n' "Enable pwd auth:"   "$(((ENABLE_PASSWORD_AUTH)) && echo yes || echo no)"
    printf '  %-22s %s\n' "Set password now:"  "$(((SET_PASSWORD))     && echo yes || echo no)"
    [[ -n "$INSTALL_BINARY" ]] && printf '  %-22s %s\n' "Install binary:" "$INSTALL_BINARY → /usr/local/bin/$(basename "$INSTALL_BINARY")"
    [[ -n "$SOURCE_DIR" ]]     && printf '  %-22s %s\n' "Move directory:" "$SOURCE_DIR → /home/$USERNAME/$DEST_NAME"
    if [[ -n "$LAUNCH_CMD" ]]; then
        printf '  %-22s %s\n' "Auto-launch:"   "$LAUNCH_CMD"
    else
        printf '  %-22s %s\n' "Auto-launch:"   "(none — plain shell on login)"
    fi
    (( DRY_RUN )) && printf '  %-22s %s\n' "Mode:" "DRY RUN (no changes will be made)"
    say

    if (( ! ASSUME_YES )); then
        prompt_yn "Proceed?" "y" || die "Aborted."
    fi

    say
    info "Starting setup…"

    local TMP_SCRIPT
    TMP_SCRIPT="$(mktemp)"
    trap 'rm -f "$TMP_SCRIPT"' EXIT

    cat > "$TMP_SCRIPT" <<EOF
#!/usr/bin/env bash
set -euo pipefail

USERNAME='$USERNAME'
SOURCE_USER='$SOURCE_USER'
ADD_SUDO='$ADD_SUDO'
COPY_SSH_KEYS='$COPY_SSH_KEYS'
COPY_GITCONFIG='$COPY_GITCONFIG'
ENABLE_PASSWORD_AUTH='$ENABLE_PASSWORD_AUTH'
INSTALL_BINARY='$INSTALL_BINARY'
SOURCE_DIR='$SOURCE_DIR'
DEST_NAME='$DEST_NAME'
LAUNCH_CMD='${LAUNCH_CMD//\'/\'\\\'\'}'

if id "\$USERNAME" &>/dev/null; then
    echo "[~] User '\$USERNAME' already exists"
else
    if [[ "\$ADD_SUDO" == "1" ]]; then
        useradd -m -s /bin/bash -G sudo "\$USERNAME"
        echo "[+] Created user '\$USERNAME' (sudo group)"
    else
        useradd -m -s /bin/bash "\$USERNAME"
        echo "[+] Created user '\$USERNAME' (no sudo)"
    fi
fi

USER_HOME="/home/\$USERNAME"

if [[ "\$COPY_SSH_KEYS" == "1" ]]; then
    SRC_HOME="\$(getent passwd "\$SOURCE_USER" | cut -d: -f6)"
    SRC_KEYS="\$SRC_HOME/.ssh/authorized_keys"
    if [[ -f "\$SRC_KEYS" ]]; then
        install -d -m 700 -o "\$USERNAME" -g "\$USERNAME" "\$USER_HOME/.ssh"
        install -m 600 -o "\$USERNAME" -g "\$USERNAME" "\$SRC_KEYS" "\$USER_HOME/.ssh/authorized_keys"
        echo "[+] SSH authorized_keys mirrored from \$SOURCE_USER"
    else
        echo "[~] \$SOURCE_USER has no authorized_keys, skipping"
    fi
fi

if [[ "\$COPY_GITCONFIG" == "1" ]]; then
    SRC_HOME="\$(getent passwd "\$SOURCE_USER" | cut -d: -f6)"
    if [[ -f "\$SRC_HOME/.gitconfig" ]]; then
        install -m 644 -o "\$USERNAME" -g "\$USERNAME" "\$SRC_HOME/.gitconfig" "\$USER_HOME/.gitconfig"
        echo "[+] Copied .gitconfig from \$SOURCE_USER"
    fi
fi

if [[ -n "\$INSTALL_BINARY" ]]; then
    BIN_BASE="\$(basename "\$INSTALL_BINARY")"
    DEST="/usr/local/bin/\$BIN_BASE"
    if [[ -x "\$DEST" ]]; then
        echo "[~] \$DEST already exists, leaving as-is"
    else
        install -m 755 "\$INSTALL_BINARY" "\$DEST"
        echo "[+] Installed \$INSTALL_BINARY → \$DEST"
    fi
fi

if [[ "\$ENABLE_PASSWORD_AUTH" == "1" ]]; then
    NEED_RELOAD=0
    for f in /etc/ssh/sshd_config.d/*.conf; do
        [[ -f "\$f" ]] || continue
        if grep -qE '^PasswordAuthentication[[:space:]]+no' "\$f"; then
            sed -i 's/^PasswordAuthentication[[:space:]]\+no/PasswordAuthentication yes/' "\$f"
            NEED_RELOAD=1
            echo "[+] Enabled PasswordAuthentication in \$f"
        fi
    done
    if (( NEED_RELOAD )); then
        systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || echo "[!] could not reload ssh"
    fi
fi

if [[ -n "\$SOURCE_DIR" ]]; then
    DST="\$USER_HOME/\$DEST_NAME"
    if [[ -d "\$SOURCE_DIR" && ! -e "\$DST" ]]; then
        mv "\$SOURCE_DIR" "\$DST"
        chown -R "\$USERNAME:\$USERNAME" "\$DST"
        echo "[+] Moved \$SOURCE_DIR → \$DST"
    elif [[ -e "\$DST" ]]; then
        echo "[~] \$DST already exists, skipping move"
    fi
fi

PROFILE="\$USER_HOME/.bash_profile"
LAUNCH_DIR="\$USER_HOME"
if [[ -n "\$DEST_NAME" && -d "\$USER_HOME/\$DEST_NAME" ]]; then
    LAUNCH_DIR="\$USER_HOME/\$DEST_NAME"
fi

if [[ -n "\$LAUNCH_CMD" ]]; then
    cat > "\$PROFILE" <<PROFILE_EOF
[[ -f ~/.bashrc ]] && source ~/.bashrc

# Auto-launch on interactive SSH login.
#   SSH_TTY        — interactive SSH only (sftp/scp/exec untouched).
#   AUTO_LAUNCHED  — one-shot env guard exported on first launch and
#                    inherited by subshells the launched program spawns
#                    (e.g., AI agents that source the user profile for
#                    each Bash tool call). Prevents infinite recursion.
if [[ -n "\\\${SSH_TTY:-}" && -z "\\\${AUTO_LAUNCHED:-}" ]]; then
    export AUTO_LAUNCHED=1
    cd "\$LAUNCH_DIR" 2>/dev/null || cd ~
    exec \$LAUNCH_CMD
fi
PROFILE_EOF
    chown "\$USERNAME:\$USERNAME" "\$PROFILE"
    chmod 644 "\$PROFILE"
    echo "[+] Wrote \$PROFILE (auto-launch: \$LAUNCH_CMD)"
else
    echo "[~] No launch command; leaving default .bash_profile"
fi
EOF

    chmod +x "$TMP_SCRIPT"

    if (( DRY_RUN )); then
        info "Dry run — would execute the following as root:"
        say
        sed 's/^/    /' "$TMP_SCRIPT"
        return 0
    fi

    sudo bash "$TMP_SCRIPT"

    if (( SET_PASSWORD )); then
        say
        info "Set the password for $USERNAME:"
        sudo passwd "$USERNAME"
    fi

    say
    ok "All done."
    say
    say "Verify in a separate terminal:"
    say "    ssh $USERNAME@<host>"
    if [[ -n "$LAUNCH_CMD" ]]; then
        local landing="~"
        [[ -n "$DEST_NAME" ]] && landing="~/$DEST_NAME"
        say "    # Lands in $landing and auto-launches: $LAUNCH_CMD"
    fi
    say
    say "Rollback (removes user + home, restores moved dir):"
    local rb="$SCRIPT_NAME rollback --username $USERNAME"
    [[ -n "$SOURCE_DIR" ]] && rb="$rb --restore-dir '$SOURCE_DIR' --from-dest '$DEST_NAME'"
    [[ -n "$INSTALL_BINARY" ]] && rb="$rb --uninstall-binary '/usr/local/bin/$(basename "$INSTALL_BINARY")'"
    say "    $rb"
    say
}

# =====================================================
#   rollback
# =====================================================
usage_rollback() {
    cat <<EOF
$SCRIPT_NAME rollback — undo a previous setup.

USAGE
    $SCRIPT_NAME rollback --username NAME [OPTIONS]

OPTIONS
    --username NAME             User to remove (required)
    --restore-dir PATH          Original path to restore the moved dir to
    --from-dest NAME            Name of the dir inside ~USERNAME (required if --restore-dir set)
    --uninstall-binary PATH     Remove a binary installed in /usr/local/bin/
    -y, --yes                   Skip confirmation
    -h, --help                  Show this help
EOF
}

cmd_rollback() {
    preflight

    local USERNAME="" RESTORE_DIR="" FROM_DEST="" UNINSTALL_BINARY="" ASSUME_YES=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --username)         USERNAME="$2"; shift 2 ;;
            --restore-dir)      RESTORE_DIR="$2"; shift 2 ;;
            --from-dest)        FROM_DEST="$2"; shift 2 ;;
            --uninstall-binary) UNINSTALL_BINARY="$2"; shift 2 ;;
            -y|--yes)           ASSUME_YES=1; shift ;;
            -h|--help)          usage_rollback; exit 0 ;;
            *) die "Unknown option: $1. Try '$SCRIPT_NAME rollback --help'." ;;
        esac
    done

    [[ -n "$USERNAME" ]] || die "--username is required."
    if [[ -n "$RESTORE_DIR" && -z "$FROM_DEST" ]]; then
        die "--from-dest is required when --restore-dir is used."
    fi

    say "Plan:"
    say "  Remove user:      $USERNAME (and home directory)"
    [[ -n "$RESTORE_DIR" ]]      && say "  Restore dir:      /home/$USERNAME/$FROM_DEST → $RESTORE_DIR"
    [[ -n "$UNINSTALL_BINARY" ]] && say "  Remove binary:    $UNINSTALL_BINARY"

    if (( ! ASSUME_YES )); then
        prompt_yn "Proceed?" "n" || die "Aborted."
    fi

    sudo bash <<EOF
set -euo pipefail
USERNAME='$USERNAME'
RESTORE_DIR='$RESTORE_DIR'
FROM_DEST='$FROM_DEST'
UNINSTALL_BINARY='$UNINSTALL_BINARY'

if [[ -n "\$RESTORE_DIR" && -d "/home/\$USERNAME/\$FROM_DEST" ]]; then
    if [[ -e "\$RESTORE_DIR" ]]; then
        echo "[!] \$RESTORE_DIR already exists, skipping restore" >&2
    else
        mkdir -p "\$(dirname "\$RESTORE_DIR")"
        mv "/home/\$USERNAME/\$FROM_DEST" "\$RESTORE_DIR"
        OWNER="\$(stat -c '%U:%G' "\$(dirname "\$RESTORE_DIR")")"
        chown -R "\$OWNER" "\$RESTORE_DIR"
        echo "[+] Restored \$RESTORE_DIR (owner: \$OWNER)"
    fi
fi

if id "\$USERNAME" &>/dev/null; then
    pkill -KILL -u "\$USERNAME" 2>/dev/null || true
    userdel -r "\$USERNAME"
    echo "[+] Removed user \$USERNAME"
else
    echo "[~] User \$USERNAME not present"
fi

if [[ -n "\$UNINSTALL_BINARY" && -e "\$UNINSTALL_BINARY" ]]; then
    rm -f "\$UNINSTALL_BINARY"
    echo "[+] Removed \$UNINSTALL_BINARY"
fi
EOF

    ok "Rollback complete."
}

# =====================================================
#   top-level dispatch
# =====================================================
usage_top() {
    cat <<EOF
$SCRIPT_NAME v$VERSION — dedicated SSH user with command auto-launch.

USAGE
    $SCRIPT_NAME [SUBCOMMAND] [OPTIONS]

SUBCOMMANDS
    create      Create the user (default when no subcommand is given)
    rollback    Undo a previous setup

GLOBAL
    --version, -V    Show version
    --help, -h       Show this help

Run '$SCRIPT_NAME create --help' or '$SCRIPT_NAME rollback --help' for details.

Quick start (no clone required):
    bash <(curl -fsSL https://raw.githubusercontent.com/tylercd100/ssh-launcher-user/main/ssh-launcher-user)
EOF
}

main() {
    case "${1:-}" in
        create)            shift; cmd_create "$@" ;;
        rollback)          shift; cmd_rollback "$@" ;;
        -V|--version)      echo "$SCRIPT_NAME $VERSION" ;;
        -h|--help|help|"") # default to create's help when no args / explicit help
            if [[ "${1:-}" == "" ]]; then
                cmd_create
            else
                usage_top
            fi
            ;;
        -*) cmd_create "$@" ;;  # flags without subcommand → create
        *)  die "Unknown subcommand: $1. Try '$SCRIPT_NAME --help'." ;;
    esac
}

main "$@"
